# Copy to .env and fill in. Never commit .env.

# Vision/LLM provider: anthropic (default) | gemini | openai
LLM_PROVIDER=anthropic
# Leave empty to use the provider default (anthropic: claude-opus-5-5, gemini: gemini-3.6-flash, openai: gpt-4.1)
# Gemini Pro models (e.g. gemini-3.1-pro-preview) need a paid-tier key; the free tier serves Flash models only.
LLM_MODEL=
# Anthropic effort level: low | medium | high | xhigh | max
LLM_EFFORT=medium
# Server-side refusal fallback for Claude (default) or "off"
LLM_FALLBACKS=default
# Gemini only: models to try, in order, when the main one is overloaded (HTTP 503) or out of daily quota,
# e.g. gemini-3.8-flash,gemini-3.5-flash. Outputs count the calls (live and cached) each model answered.
LLM_FALLBACK_MODELS=
# Gemini only: pace requests per model (requests per minute; 0 = no pacing). Free-tier keys allow 5: use 4.5.
LLM_MAX_RPM=0
# Gemini only: retries for HTTP 429 (per-minute quota), 5xx and network errors, with backoff
LLM_MAX_RETRIES=5
# Disk cache of structured LLM responses in .cache/llm (on|off)
LLM_CACHE=on

# Set the key for the provider you use
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: an OpenAI-compatible gateway for LLM_PROVIDER=openai, e.g. https://aipipe.org/openai/v1 (AI Pipe)
OPENAI_BASE_URL=

# Web search for the inventory agent: auto | tavily | llm | duckduckgo
#   auto = Tavily if TAVILY_API_KEY is set, else the LLM's own web search (Claude/Gemini) falling back to
#          DuckDuckGo (key-free) when that fails, else DuckDuckGo
SEARCH_PROVIDER=auto
TAVILY_API_KEY=

# Human-review threshold for field confidence (0-1)
REVIEW_THRESHOLD=0.85
# Question 3 crop reads: per_field (one request per crop, ~10 per form) or batched (~4 requests per document,
# for rate-limited keys such as the Gemini free tier with 20 requests per model per day)
CROP_READS=per_field
# Sandbox limits for generated pandas code
EXEC_TIMEOUT_SECONDS=10
MAX_OUTPUT_CHARS=20000
# PDF rasterisation resolution
PDF_DPI=200
